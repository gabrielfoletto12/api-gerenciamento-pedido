                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Quantidade atualizada\", function () { pm.expect(pm.response.json().quantidade).to.eql(20); });"
