      "item": [
        {
          "name": "Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta paginada\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"content\"); pm.expect(j).to.have.property(\"totalPages\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlPedidos}}/v1/produtos",
              "host": [
                "{{baseUrlPedidos}}"
              ],
              "path": [
                "v1",
                "produtos"
              ]
            },
            "description": "GET lista os produtos (resposta paginada). Não altera nada no servidor."
          },
          "response": []
        },
