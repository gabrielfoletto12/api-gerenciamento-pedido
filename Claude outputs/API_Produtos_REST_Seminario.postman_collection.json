              "path": [
                "v1",
                "produtos",
                "1"
              ]
            },
            "description": "PATCH altera só os campos enviados (aqui, a quantidade).",
            "body": {
              "mode": "raw",
              "raw": "{\"quantidade\":20}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
