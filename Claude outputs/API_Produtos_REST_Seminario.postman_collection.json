          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrlPedidos}}/v1/produtos",
              "host": [
                "{{baseUrlPedidos}}"
              ],
              "path": [
                "v1",
                "produtos"
              ]
            },
            "description": "POST cria um recurso. Devolve 201 e o header Location.",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Teclado\",\"preco\":250,\"quantidade\":15}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
