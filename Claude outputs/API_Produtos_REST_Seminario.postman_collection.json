              "path": [
                "v1",
                "produtos"
              ]
            },
            "description": "Erro 409: já existe produto com esse nome. Mostra que o POST NÃO é idempotente.",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Teclado\",\"preco\":250,\"quantidade\":15}",
              "options": {
                "raw": {
                  "language": "json"
                }
